# =============================================================================
# LLM 配置 / LLM Configuration
# =============================================================================

# LLM 提供商: openai / anthropic / azure
LLM_PROVIDER=openai

# 模型名称
LLM_MODEL=gpt-4o

# API 密钥
LLM_API_KEY=your-api-key-here

# API 基础 URL（可选，用于代理或自定义端点）
LLM_BASE_URL=https://api.openai.com/v1

# 生成温度 (0.0-2.0)
LLM_TEMPERATURE=0.7

# 请求超时时间（秒）
LLM_REQUEST_TIMEOUT=120

# =============================================================================
# MCP 配置 / MCP Configuration
# =============================================================================

# 是否启用顺序思考 MCP
MCP_SEQUENTIAL_THINKING_ENABLED=true

# 是否启用 Context7 MCP
MCP_CONTEXT7_ENABLED=true

# MCP 调用超时时间（秒）
MCP_CALL_TIMEOUT=60

# =============================================================================
# 代理行为配置 / Agent Behavior Configuration
# =============================================================================

# 最大审查迭代次数
MAX_REVIEW_ITERATIONS=10

# 停滞阈值（连续相同结果次数）
STAGNATION_THRESHOLD=3

# 用户批准超时时间（秒）
USER_APPROVAL_TIMEOUT=300

# 单任务最大成本限制（美元）
LLM_MAX_COST_PER_TASK=10.0

# =============================================================================
# 系统配置 / System Configuration
# =============================================================================

# 工作空间目录
WORKSPACE_DIR=./workspace

# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/docreview.log

# 日志最大大小（字节）
LOG_MAX_BYTES=10485760

# 日志备份数量
LOG_BACKUP_COUNT=5

# =============================================================================
# Laya 决策层 / Laya Decision Layer
# =============================================================================
# 注意：嵌套子配置必须用双下划线分隔（__），单下划线的扁平形式（如
# LAYA_ENABLED）只会被读取为「未知配置」并告警，不会写入 config.laya。
# 详见 CLAUDE.md「跨仓库注意事项」中关于 env_nested_delimiter 的说明。

# 总开关：默认关闭。关闭时全部判定恒为 uncertain（规格 §0.2）
LAYA__ENABLED=false

# Laya 运行时权威 commit（完整 40 位 SHA）；启用时必填
LAYA__RUNTIME_COMMIT=970dc8c5f63d7b886a68409493f37d569424f933

# 逻辑模型名：auto / english / multilingual / typed-decisions
# auto 与 typed-decisions 仅 audit-only；任何 act 必须显式 english 或 multilingual
LAYA__MODEL=auto

# 权重 bundle 根目录（绝对路径）。english→根，multilingual→根/multilingual，
# typed-decisions→根/typed-decisions。缺失或相对路径 → audit-only 降级
LAYA__MODEL_DIR=

# checkpoint manifest 绝对路径（由 scripts/build_laya_checkpoint_manifest.py 产出）
# 不得写入上游权重仓库 laya-huggingface
LAYA__CHECKPOINT_MANIFEST_PATH=

# calibration 绝对路径。缺失或相对路径 → audit-only 降级
LAYA__CALIBRATION_PATH=

# 推理设备：可能产生 act 的运行必须为 cpu；auto 仅 audit-only
LAYA__DEVICE=auto

# 输入 token 上限（不得超过 checkpoint 上限）
LAYA__MAX_LEN=8192

# head token 上限，必须小于 max_len
LAYA__HEAD_MAX_LEN=256

# 分块上限（规格固定为 8，超过则头尾各 4）
LAYA__CHUNK_LIMIT=8

# 单块字符预算（固定安全值）
LAYA__MAX_CHARS_PER_CHUNK=1024

# Agent forward batch 上限
LAYA__BATCH_SIZE=4

# 单 batch 逻辑行上限（v1 固定为 8）
LAYA__MAX_BATCH_ROWS=8

# 单 batch encoded state 字符上限（v1 固定为 16384）
LAYA__MAX_BATCH_ENCODED_CHARS=16384

# 单次推理超时时间（秒）
LAYA__TIMEOUT_SECONDS=120

# 提醒：LayaConfig **不提供任何业务阈值覆盖字段**。阈值只能来自 calibration
# manifest，配置里加阈值旋钮是违规的（规格 §11.1）。
